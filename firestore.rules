rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // HARDENED SECURITY ARCHITECTURE (ANTI-INTRUSION, ANTI-XSS, ANTI-ESCALATION)
    // ========================================================================

    // Default Deny Catch-All: Block any unmapped paths unconditionally
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Path Variable Hardening (Anti-ID Poisoning & Directory Traversal)
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\. ]+$') && id != '.' && id != '..';
    }

    // Class IDs frequently contain spaces, hyphens, en-dashes, parentheses, or dots (e.g. 'Kelas IX-A', 'Kelas 9.1')
    function isValidClassId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 &&
        !id.matches('.*[/<>\\\\"\'`].*') &&
        id != '.' && id != '..' &&
        isCleanText(id);
    }

    // Exact verified Super Admin email allowlist or admins/{uid} lookup
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null &&
         request.auth.token.email_verified == true &&
         request.auth.token.email in ['sobari.661@guru.smp.belajar.id', 'sobari@sekolah.sch.id']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Anti-XSS & Anti-Deface String Validator
    function isCleanText(val) {
      return val is string &&
        !val.matches('(?i).*<(script|iframe|svg|object|embed|style|form).*') &&
        !val.matches('(?i).*(onerror|onload|onclick|javascript:|vbscript:|dhimasganteng|deface\\.js).*');
    }

    function isSafeOptionalText(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen && isCleanText(data[field]));
    }

    // ========================================================================
    // SCHEMA BLUEPRINT GUARDS (STRICT KEYS & TYPES, ANTI-SHADOW-UPDATES)
    // ========================================================================

    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'name', 'nisn', 'classId']) &&
        data.keys().hasOnly([
          'id', 'name', 'nisn', 'classId', 'gender', 'address', 'phone',
          'parentName', 'parentNik', 'parentPhone', 'parentEmail', 'avatarUrl',
          'password', 'parentPassword', 'guruWaliTeacherId', 'bakatMinat',
          'prestasi', 'isKjpRecipient', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 && isCleanText(data.name) &&
        data.nisn is string && data.nisn.size() <= 20 &&
        data.classId is string && data.classId.size() <= 50 &&
        isSafeOptionalText(data, 'phone', 30) &&
        isSafeOptionalText(data, 'address', 300) &&
        (!('gender' in data) || (data.gender in ['Laki-laki', 'Perempuan'])) &&
        isSafeOptionalText(data, 'parentName', 150) &&
        isSafeOptionalText(data, 'parentPhone', 30) &&
        isSafeOptionalText(data, 'parentEmail', 100);
    }

    function isValidTeacher(data) {
      return data.keys().hasAll(['id', 'name', 'nip', 'role']) &&
        data.keys().hasOnly([
          'id', 'name', 'nip', 'email', 'role', 'roles', 'classId', 'password',
          'ekskulId', 'ekskulName', 'subject', 'avatarUrl', 'born', 'hobby',
          'motto', 'phone', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 && isCleanText(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 && isCleanText(data.name) &&
        data.nip is string && data.nip.size() <= 50 &&
        data.role is string && data.role.size() <= 30 &&
        isSafeOptionalText(data, 'email', 100) &&
        isSafeOptionalText(data, 'classId', 128) &&
        isSafeOptionalText(data, 'phone', 30) &&
        isSafeOptionalText(data, 'motto', 500) &&
        (!('roles' in data) || data.roles == null || (data.roles is list && data.roles.size() <= 10));
    }

    function isValidClass(data) {
      return data.keys().hasAll(['id', 'name']) &&
        data.keys().hasOnly(['id', 'name', 'level', 'academicYear', 'homeroomTeacherId', 'totalStudents', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 && isCleanText(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 80 && isCleanText(data.name) &&
        isSafeOptionalText(data, 'homeroomTeacherId', 128) &&
        isSafeOptionalText(data, 'level', 20) &&
        isSafeOptionalText(data, 'academicYear', 30) &&
        (!('totalStudents' in data) || data.totalStudents == null || data.totalStudents is number);
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['id', 'studentId', 'date', 'status']) &&
        data.keys().hasOnly([
          'id', 'studentId', 'classId', 'date', 'status', 'time', 'notes',
          'recordedBy', 'verified', 'timestamp', 'photoProof', 'isSelfAttendance',
          'isVerifiedByPiket', 'isVerifiedByMapel', 'verificationStatus',
          'verifiedByPiketAt', 'verifiedByMapelAt', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() <= 128 &&
        data.studentId is string && data.studentId.size() <= 128 &&
        data.date is string && data.date.size() <= 30 &&
        data.status in ['Hadir', 'Sakit', 'Izin', 'Alpa', 'Terlambat'] &&
        isSafeOptionalText(data, 'classId', 50) &&
        isSafeOptionalText(data, 'time', 30) &&
        isSafeOptionalText(data, 'timestamp', 50) &&
        (!('photoProof' in data) || (data.photoProof is string && data.photoProof.size() <= 100000)) &&
        isSafeOptionalText(data, 'notes', 300) &&
        isSafeOptionalText(data, 'recordedBy', 150) &&
        (!('verified' in data) || data.verified is bool) &&
        (!('isSelfAttendance' in data) || data.isSelfAttendance is bool) &&
        (!('isVerifiedByPiket' in data) || data.isVerifiedByPiket is bool) &&
        (!('isVerifiedByMapel' in data) || data.isVerifiedByMapel is bool);
    }

    function isValidViolation(data) {
      return data.keys().hasAll(['id', 'studentId', 'violationTypeId', 'points']) &&
        data.keys().hasOnly([
          'id', 'studentId', 'violationTypeId', 'date', 'reporterId', 'reporterRole',
          'points', 'notes', 'status', 'penalty', 'recordedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() <= 128 &&
        data.studentId is string && data.studentId.size() <= 128 &&
        data.violationTypeId is string && data.violationTypeId.size() <= 128 &&
        data.points is number && data.points >= 0 && data.points <= 500 &&
        isSafeOptionalText(data, 'date', 30) &&
        isSafeOptionalText(data, 'notes', 1000) &&
        isSafeOptionalText(data, 'recordedBy', 150) &&
        isSafeOptionalText(data, 'reporterId', 128) &&
        isSafeOptionalText(data, 'reporterRole', 50) &&
        isSafeOptionalText(data, 'status', 50) &&
        isSafeOptionalText(data, 'penalty', 300) &&
        isSafeOptionalText(data, 'createdAt', 50) &&
        isSafeOptionalText(data, 'updatedAt', 50);
    }

    function isValidViolationType(data) {
      return data.keys().hasAll(['id', 'name', 'points']) &&
        data.keys().hasOnly(['id', 'name', 'points', 'category', 'description', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 && isCleanText(data.name) &&
        data.points is number && data.points >= 0 && data.points <= 500 &&
        isSafeOptionalText(data, 'category', 100) &&
        isSafeOptionalText(data, 'description', 500) &&
        isSafeOptionalText(data, 'createdAt', 50) &&
        isSafeOptionalText(data, 'updatedAt', 50);
    }

    function isValidPendingRegistration(data) {
      return data.keys().hasAll(['id', 'role', 'name']) &&
        data.keys().hasOnly([
          'id', 'role', 'name', 'nipOrNisnOrNik', 'email', 'phone',
          'gender', 'classId', 'studentNisnOrName', 'address',
          'password', 'createdAt', 'updatedAt', 'status'
        ]) &&
        data.id is string && data.id.size() <= 128 &&
        data.role in ['guru', 'siswa', 'orang_tua', 'pelatih'] &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 && isCleanText(data.name) &&
        isSafeOptionalText(data, 'nipOrNisnOrNik', 50) &&
        isSafeOptionalText(data, 'email', 100) &&
        isSafeOptionalText(data, 'phone', 30) &&
        isSafeOptionalText(data, 'address', 300) &&
        isSafeOptionalText(data, 'classId', 50) &&
        isSafeOptionalText(data, 'gender', 20) &&
        isSafeOptionalText(data, 'studentNisnOrName', 100) &&
        isSafeOptionalText(data, 'password', 100) &&
        isSafeOptionalText(data, 'createdAt', 50) &&
        isSafeOptionalText(data, 'updatedAt', 50) &&
        isSafeOptionalText(data, 'status', 30) &&
        !('isAdmin' in data);
    }

    function isCleanContent(data) {
      return isSafeOptionalText(data, 'headMotto', 5000) &&
        isSafeOptionalText(data, 'headName', 150) &&
        isSafeOptionalText(data, 'headerTitle', 200) &&
        isSafeOptionalText(data, 'headerSubtitle', 500) &&
        isSafeOptionalText(data, 'headerMotto', 300) &&
        isSafeOptionalText(data, 'sambutan', 5000) &&
        isSafeOptionalText(data, 'vision', 2000) &&
        isSafeOptionalText(data, 'visi', 2000);
    }

    function isValidWebContent(data) {
      return data.keys().hasAll(['id']) &&
        data.keys().hasOnly([
          'id', 'headerBgImage', 'headerTitle', 'headerSubtitle', 'headerMotto',
          'schoolLogo', 'akreditasi', 'headName', 'headImage', 'headRole',
          'headMotto', 'headBorn', 'headSubject', 'headHobby',
          'staff', 'programs', 'slides', 'subjects', 'extracurriculars',
          'facilities', 'popupImages', 'articles', 'tickers', 'activities',
          'agendas', 'sambutan', 'visi', 'vision', 'missions',
          'visionPillarsTitle', 'visionPillars',
          'instagram', 'whatsapp', 'email', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() <= 128 &&
        isCleanContent(data) &&
        (!('schoolLogo' in data) || (data.schoolLogo is string && data.schoolLogo.size() <= 250000)) &&
        (!('headImage' in data) || (data.headImage is string && data.headImage.size() <= 250000)) &&
        (!('headerBgImage' in data) || (data.headerBgImage is string && data.headerBgImage.size() <= 350000)) &&
        isSafeOptionalText(data, 'akreditasi', 100) &&
        isSafeOptionalText(data, 'visionPillarsTitle', 500) &&
        (!('visionPillars' in data) || (data.visionPillars is list && data.visionPillars.size() <= 10)) &&
        (!('slides' in data) || (data.slides is list && data.slides.size() <= 20));
    }

    function isValidSettings(data) {
      return data.keys().hasOnly([
          'id', 'name', 'nip', 'logoLeft', 'logoRight', 'govTitle', 'deptTitle',
          'sudinTitle', 'schoolTitle', 'addressText', 'contactText', 'docNumber',
          'photo', 'headImage',
          'cardTitle', 'cardSubtitle', 'cardValidity', 'issueDate', 'schoolName',
          'headmasterName', 'headmasterNip', 'presetId', 'bgType', 'customBgImage',
          'showWatermark', 'watermarkOpacity', 'backTitle', 'rules', 'footerNote',
          'cardLogo', 'bypassPin', 'schoolStartTime', 'latePenaltyPoints',
          'isLatePenaltyEnabled', 'initialized', 'initializedAt', 'createdAt', 'updatedAt'
        ]) &&
        isSafeOptionalText(data, 'id', 128) &&
        isSafeOptionalText(data, 'name', 150) &&
        isSafeOptionalText(data, 'nip', 50) &&
        (!('photo' in data) || (data.photo is string && data.photo.size() <= 250000)) &&
        (!('headImage' in data) || (data.headImage is string && data.headImage.size() <= 250000)) &&
        isSafeOptionalText(data, 'schoolTitle', 200) &&
        isSafeOptionalText(data, 'addressText', 300) &&
        isSafeOptionalText(data, 'contactText', 300) &&
        isSafeOptionalText(data, 'bypassPin', 30);
    }

    function isValidQuestionBank(data) {
      return data.keys().hasAll(['id', 'teacherId', 'title', 'questions']) &&
        data.keys().hasOnly(['id', 'teacherId', 'teacherName', 'subject', 'title', 'classId', 'createdAt', 'updatedAt', 'questions']) &&
        data.id is string && data.id.size() <= 128 &&
        data.teacherId is string && data.teacherId.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 && isCleanText(data.title) &&
        data.questions is list && data.questions.size() <= 200;
    }

    function isValidAggregatedContainer(data) {
      return data.keys().hasAll(['items']) &&
        data.keys().hasOnly(['items', 'createdAt', 'lastUpdated']) &&
        data.items is list && data.items.size() <= 500 &&
        isSafeOptionalText(data, 'createdAt', 50) &&
        isSafeOptionalText(data, 'lastUpdated', 50);
    }

    // ========================================================================
    // COLLECTION ACCESS RULES & ZERO-TRUST GATES
    // ========================================================================

    // 1. Public Website Content: Read public; write validated; delete admin-only
    match /web_content/{contentId} {
      allow get, list: if true;
      allow create, update: if isValidId(contentId) && isValidWebContent(incoming());
      allow delete: if isAdmin();
    }

    // 2. School Settings & Configurations (Kop Surat, Logo, Card Design, CBT PIN)
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isValidId(settingId) && isValidSettings(incoming());
      allow delete: if isAdmin();
    }

    // 3. User Self-Registration (Pending registrations)
    match /pending_registrations/{regId} {
      allow get, list: if true;
      allow create, update: if isValidId(regId) && isValidPendingRegistration(incoming());
      allow delete: if isValidId(regId);
    }

    // 4. Students Collection
    match /students/{studentId} {
      allow get, list: if true;
      allow create, update: if isValidId(studentId) && isValidStudent(incoming());
      allow delete: if isValidId(studentId);
    }

    // 5. Teachers & Staff Collection (Anti-Admin Privilege Escalation after system_init)
    match /teachers/{teacherId} {
      allow get, list: if true;
      allow create: if isValidId(teacherId) && isValidTeacher(incoming()) && (
        isAdmin() ||
        !exists(/databases/$(database)/documents/settings/system_init) ||
        (incoming().role != 'admin' && (!('roles' in incoming()) || !('admin' in incoming().roles)))
      );
      allow update: if isValidId(teacherId) && isValidTeacher(incoming()) && (
        isAdmin() ||
        (
          (existing().role == 'admin' || incoming().role != 'admin') &&
          (!('roles' in incoming()) || !('admin' in incoming().roles) || existing().role == 'admin' || ('roles' in existing() && 'admin' in existing().roles))
        )
      );
      allow delete: if isValidId(teacherId) && (isAdmin() || existing().role != 'admin');
    }

    // 6. Classes Collection
    match /classes/{classId} {
      allow get, list: if true;
      allow create, update: if isValidClassId(classId) && isValidClass(incoming());
      allow delete: if isValidClassId(classId);
    }

    // 7. Attendance Collection
    match /attendance/{attId} {
      allow get, list: if true;
      allow create, update: if isValidId(attId) && isValidAttendance(incoming());
      allow delete: if isValidId(attId);
    }

    // 8. Student Violations
    match /violations/{violId} {
      allow get, list: if true;
      allow create, update: if isValidId(violId) && isValidViolation(incoming());
      allow delete: if isValidId(violId);
    }

    // 9. Violation Types
    match /violation_types/{typeId} {
      allow get, list: if true;
      allow create, update: if isValidId(typeId) && isValidViolationType(incoming());
      allow delete: if isValidId(typeId);
    }

    // 10. Counselor Notes, Homeroom Notes, Parent Messages
    match /counselor_notes/{noteId} {
      allow get, list: if true;
      allow create, update: if isValidId(noteId) && incoming().id is string && isSafeOptionalText(incoming(), 'note', 2000);
      allow delete: if isValidId(noteId);
    }

    match /homeroom_notes/{noteId} {
      allow get, list: if true;
      allow create, update: if isValidId(noteId) && incoming().id is string && isSafeOptionalText(incoming(), 'note', 2000);
      allow delete: if isValidId(noteId);
    }

    match /parent_messages/{msgId} {
      allow get, list: if true;
      allow create, update: if isValidId(msgId) && incoming().id is string && isSafeOptionalText(incoming(), 'message', 2000);
      allow delete: if isValidId(msgId);
    }

    // 11. Exams & CBT Configurations
    match /exam_schedules/{examId} {
      allow get, list: if true;
      allow create, update: if isValidId(examId) && incoming().id is string;
      allow delete: if isValidId(examId);
    }

    match /exam_grades/{gradeId} {
      allow get, list: if true;
      allow create, update: if isValidId(gradeId) && incoming().id is string && incoming().score is number;
      allow delete: if isValidId(gradeId);
    }

    match /cbt_config/{configId} {
      allow get, list: if true;
      allow create, update: if isValidId(configId);
      allow delete: if isAdmin();
    }

    match /student_submissions/{subId} {
      allow get, list: if true;
      allow create, update: if isValidId(subId) && incoming().id is string;
      allow delete: if isValidId(subId);
    }

    match /question_banks/{bankId} {
      allow get, list: if true;
      allow create, update: if isValidId(bankId) && isValidQuestionBank(incoming());
      allow delete: if isValidId(bankId);
    }

    // 12. Journals & Schedules
    match /teaching_journals/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    match /bimbingan_journals/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    match /bimbingan_schedules/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    // 13. Achievements & E-Learning
    match /student_achievements/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string && isSafeOptionalText(incoming(), 'title', 300);
      allow delete: if isValidId(id);
    }

    match /elearning_materials/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    match /elearning_progress/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    // 13b. Extracurricular Members & Dynamic Coach Collections
    match /ekskul_members/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    match /{dynCol}/{docId} {
      allow get, list: if dynCol.matches('^(attendance|journals|grades)_[a-zA-Z0-9_\\-]+$');
      allow create, update: if dynCol.matches('^(attendance|journals|grades)_[a-zA-Z0-9_\\-]+$') && isValidId(docId) && incoming().id is string;
      allow delete: if dynCol.matches('^(attendance|journals|grades)_[a-zA-Z0-9_\\-]+$') && isValidId(docId);
    }

    // 14. Administrative / Tendik
    match /pemberkasan_schedules/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    match /nomor_surat/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    match /inventory_items/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    match /inventory_loans/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    match /bos_bop_reports/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    match /absent_teachers/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    match /important_events/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    // ECo-Tiket (Bank Sampah & Penebusan Pelanggaran / Duta Kebersihan)
    match /eco_categories/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    match /eco_waste_categories/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    match /eco_deposits/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    match /eco_rewards/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    match /eco_redemptions/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    match /eco_config/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id);
      allow delete: if isAdmin();
    }

    // 14b. Student Permits (Toilet, Keluar Kelas, Pulang Cepat, Track Record)
    match /student_permits/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && incoming().id is string;
      allow delete: if isValidId(id);
    }

    // 15. Aggregated Realtime Containers
    match /aggregated_announcements/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && isValidAggregatedContainer(incoming());
      allow delete: if isAdmin();
    }

    match /aggregated_activities/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && isValidAggregatedContainer(incoming());
      allow delete: if isAdmin();
    }

    match /aggregated_messages/{id} {
      allow get, list: if true;
      allow create, update: if isValidId(id) && isValidAggregatedContainer(incoming());
      allow delete: if isAdmin();
    }

    // 16. User Static Profiles
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isAdmin();
    }

    // 17. System Diagnostics (Pemeriksaan Integritas & Uji Mandiri Database)
    match /system_diagnostics/{testId} {
      allow get, list: if true;
      allow create, update: if isValidId(testId);
      allow delete: if isValidId(testId);
    }

    // 18. Admins Reference Collection (Hanya Admin yang berwenang)
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if isAdmin();
    }
  }
}
